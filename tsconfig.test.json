{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "test",
    "e2e",
    "apps/*/test",
    "packages/*/test",
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts",
    "vitest.config.ts"
  ]
}
