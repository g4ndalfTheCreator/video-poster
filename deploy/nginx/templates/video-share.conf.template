# Public listener: viewer pages and media; the admin UI/API too unless ADMIN_LISTENER=private.
server {
  listen 8080 default_server;
  include /etc/nginx/generated/tls.conf;
  server_name _;
  client_max_body_size 2m;
  root /usr/share/nginx/empty;
  autoindex off;
  set $vs_listener public;
  include /etc/nginx/conf.d/locations.inc;
}

# Private admin listener. Published on ADMIN_BIND:ADMIN_PORT (default 127.0.0.1:8081) for SSH tunnels
# or a VPN; the admin network allowlist applies here as well.
server {
  listen 8081;
  server_name _;
  client_max_body_size 2m;
  root /usr/share/nginx/empty;
  autoindex off;
  set $vs_listener admin;
  include /etc/nginx/conf.d/locations.inc;
}
