{
  "name": "video-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "dev:api": "pnpm --filter @vs/api dev",
    "dev:worker": "pnpm --filter @vs/worker dev",
    "dev:admin": "pnpm --filter @vs/admin dev",
    "db:migrate": "pnpm --filter @vs/core migrate",
    "seed:telemetry": "pnpm --filter @vs/worker seed:telemetry",
    "sbom": "pnpm dlx @cyclonedx/cdxgen@11 -t pnpm -r -o sbom.json .",
    "fixtures": "tsx -e \"import('./test/fixtures.ts').then(m=>m.ensureFixtures())\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/node": "^22.18.0",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "postgres": "~3.4.7",
    "prettier": "^3.6.2",
    "smtp-server": "^3.21.3",
    "testcontainers": "^11.7.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2"
    ]
  }
}
